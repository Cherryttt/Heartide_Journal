# ============================================
# MoodGarden 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# --- 智谱 AI API ---
# 注册地址: https://open.bigmodel.cn/
# 控制台: https://open.bigmodel.cn/console/overview
# 获取 API Key: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your-zhipu-api-key-here

# --- 模型配置 ---
# GLM-4.6V: 图片理解 + 高质量文本生成 (拼贴诗/治愈文案)
GLM_VISION_MODEL=glm-4v-plus
# GLM-4.5-Flash: 快速响应 (Agent对话/自动标签兜底)
GLM_FLASH_MODEL=glm-4-flash
GLM_IMAGE_MODEL=cogview-4-250304

# --- 本地 Embedding 模型 ---
# 用于向量检索，不消耗 API 额度
# 可选: BAAI/bge-small-zh-v1.5 | shibing624/text2vec-base-chinese
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMOTION_CONFIDENCE_THRESHOLD=0.46
EMOTION_MARGIN_THRESHOLD=0.10

# --- MacBERT 情绪模型部署（可选，默认关闭）---
# 先运行 backend/ml/train_transformer_final.py 导出 checkpoint，再改为 true。
EMOTION_TRANSFORMER_ENABLED=false
EMOTION_TRANSFORMER_MODEL_PATH=./ml/macbert_emotion
EMOTION_TRANSFORMER_MAX_LENGTH=128
EMOTION_TRANSFORMER_DEVICE=auto

# --- 数据库（本地可留空 DATABASE_URL 使用 SQLite；生产使用 PostgreSQL）---
SQLITE_PATH=./data/moodgarden.db
DATABASE_URL=
CHROMA_PATH=./data/chroma
JWT_SECRET=请替换为至少32位随机字符串
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost

# --- 微信读书官方 Agent Skill API（可选）---
# Key 获取地址: https://weread.qq.com/r/weread-skills
WEREAD_API_KEY=
WEREAD_API_BASE_URL=https://i.weread.qq.com/api/agent/gateway
WEREAD_SKILL_VERSION=1.0.3
# 微信读书 Skill Key 通常绑定个人账号；只允许这个心潮手帐登录邮箱访问
WEREAD_OWNER_EMAIL=

# --- S3 / MinIO 对象存储（可选）---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=moodgarden
S3_REGION=us-east-1
S3_PUBLIC_URL=

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=10485760
