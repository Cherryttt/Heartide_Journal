{
  "name": "moodgarden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:web": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -ExecutionPolicy Bypass -File scripts/check-web-demo.ps1",
    "preview": "vite preview",
    "android:sync": "npm run android:sync:debug",
    "android:sync:debug": "npm run build && set CAPACITOR_DEBUG=true&& cap sync android",
    "android:sync:release": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync:debug && cap run android",
    "android:apk": "npm run android:sync:debug && cd android && gradlew.bat assembleDebug --no-daemon --max-workers=2",
    "android:release": "npm run android:sync:release && cd android && gradlew.bat assembleRelease --no-daemon --max-workers=2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.0",
    "@react-three/postprocessing": "^2.16.0",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
